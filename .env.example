# Storage — GCS via S3 interoperability (HMAC keys)
# https://cloud.google.com/storage/docs/interoperability
GCP_ACCESS_KEY=""
GCP_SECRET_KEY=""
GCP_STORAGE_URL="https://storage.googleapis.com"
GCP_STORAGE_REGION="asia-south1"
# Knowledge / avatars / end-user files
GCP_STORAGE_BUCKET_NAME="optimind-knowledge"
# LiveKit egress recordings (path: {orgId}/{sessionId}/{roomName}.mp4)
GCP_BUCKET_RECORDINGS="optimind-recordings"
GCP_BUCKET_TRANSCRIPTS="optimind-transcripts"
NEXT_PUBLIC_AVATARS_BUCKET_NAME="optimind-knowledge"

# Legacy S3-compatible (Supabase/MinIO/R2) — used only if GCP_* are unset
