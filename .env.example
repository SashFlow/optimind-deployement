# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
# S3_ENDPOINT_URL=""
# S3_REGION=""
# S3_BUCKET_NAME=""
# S3_BUCKET_RECORDINGS=""
# S3_BUCKET_TRANSCRIPTS=""

# AI
# ... with OpenAI
