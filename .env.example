# LiveKit (rooms, SIP, egress, agent dispatch)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
AGENT_NAME="demo-agent"

# Plivo (phone numbers + Zentrunk SIP)
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""

# Anam (avatar provider)
ANAM_API_KEY=""

# SpatialReal (avatar provider) — server-only. APP_ID is returned to the browser
# with a started web session; API_KEY stays on the server and is exchanged for a
# short-lived session token the canvas needs to download the avatar.
SPATIALREAL_APP_ID=""
SPATIALREAL_API_KEY=""

# Spatius (avatar provider) — APP_ID is returned to the browser with a started
# web session for AvatarKit. Keep SPATIUS_API_KEY on the voice worker only.
SPATIUS_APP_ID=""

# Worker → API auth (must match voice worker WORKER_INTERNAL_API_KEY)
WORKER_API_KEY=""

# BullMQ worker (session track merge). Requires system ffmpeg on the worker host.
REDIS_URL=""
