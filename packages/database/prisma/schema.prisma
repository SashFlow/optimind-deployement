datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "./generated/client"
}

generator zod {
    provider = "prisma-zod-generator"
    output   = "./zod"
    config   = "./zod-generator.config.json"
}

model User {
    id                 String       @id @default(cuid())
    name               String
    email              String
    emailVerified      Boolean
    image              String?
    createdAt          DateTime
    updatedAt          DateTime
    username           String?
    role               String?
    banned             Boolean?
    banReason          String?
    banExpires         DateTime?
    onboardingComplete Boolean      @default(false)
    paymentsCustomerId String?
    locale             String?
    twoFactorEnabled   Boolean?
    sessions           Session[]
    accounts           Account[]
    passkeys           Passkey[]
    invitations        Invitation[]
    purchases          Purchase[]
    members            Member[]
    twofactors         TwoFactor[]
    auditLogs          AuditLog[]

    @@unique([email])
    @@unique([username])
    @@map("user")
}

model Session {
    id        String   @id @default(cuid())
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    impersonatedBy String?

    activeOrganizationId String?

    token     String
    createdAt DateTime
    updatedAt DateTime

    @@unique([token])
    @@map("session")
}

model Account {
    id           String    @id @default(cuid())
    accountId    String
    providerId   String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken  String?   @db.Text
    refreshToken String?   @db.Text
    idToken      String?   @db.Text
    expiresAt    DateTime?
    password     String?

    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    createdAt             DateTime
    updatedAt             DateTime

    @@map("account")
}

model Verification {
    id         String   @id @default(cuid())
    identifier String
    value      String   @db.Text
    expiresAt  DateTime

    createdAt DateTime?
    updatedAt DateTime?

    @@map("verification")
}

model Passkey {
    id           String    @id @default(cuid())
    name         String?
    publicKey    String
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    credentialID String
    counter      Int
    deviceType   String
    backedUp     Boolean
    transports   String?
    createdAt    DateTime?

    @@map("passkey")
}

model TwoFactor {
    id          String @id @default(cuid())
    secret      String
    backupCodes String
    userId      String
    user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("twoFactor")
}

model Organization {
    id                  String               @id @default(cuid())
    name                String
    slug                String?
    logo                String?
    createdAt           DateTime
    metadata            String?
    paymentsCustomerId  String?
    members             Member[]
    invitations         Invitation[]
    purchases           Purchase[]
    auditLogs           AuditLog[]
    agents              Agent[]
    agentVersions       AgentVersion[]
    agentSessions       AgentSession[]
    sessionEvents       SessionEvent[]
    transcripts         Transcript[]
    toolCallRecords     ToolCallRecord[]
    sessionUsages       SessionUsage[]
    campaigns           Campaign[]
    campaignContacts    CampaignContact[]
    campaignAccessLinks CampaignAccessLink[]
    campaignSessions    CampaignSession[]
    knowledgeBases      KnowledgeBase[]
    phoneNumbers        PhoneNumber[]
    sipTrunks           SipTrunk[]
    dispatchRules       DispatchRule[]
    customVoices        CustomVoice[]
    egressJobs          EgressJob[]
    avatarProfiles      AvatarProfile[]
    usageMetrics        UsageMetric[]

    @@unique([slug])
    @@map("organization")
}

model Member {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId         String
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    role           String
    createdAt      DateTime

    @@unique([organizationId, userId])
    @@map("member")
}

model Invitation {
    id             String       @id @default(cuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    email          String
    role           String?
    status         String
    expiresAt      DateTime
    inviterId      String
    user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

    @@map("invitation")
}

enum PurchaseType {
    SUBSCRIPTION
    ONE_TIME
}

model Purchase {
    id             String        @id @default(cuid())
    organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    organizationId String?
    user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         String?
    type           PurchaseType
    customerId     String
    subscriptionId String?       @unique
    productId      String
    status         String?
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt

    @@index([subscriptionId])
    @@map("purchase")
}

// ------------------------------------------------------------
// ----------------------------- Audit Logs -------------------
// ------------------------------------------------------------

enum AuditActionType {
    CREATE
    UPDATE
    DELETE
    PUBLISH
    INVITE
    LOGIN
    LOGOUT
}

enum AuditActorType {
    USER
    SYSTEM
    API
}

model AuditLog {
    id             String          @id @default(cuid())
    userId         String
    user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    organizationId String
    organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    actorType      AuditActorType
    actionType     AuditActionType
    resourceType   String
    resourceId     String
    requestId      String
    ipAddress      String
    userAgent      String
    before         Json
    after          Json
}

// ------------------------------------------------------------
// ----------------------------- Agents -----------------------
// ------------------------------------------------------------

enum AgentStatus {
    ACTIVE
    INACTIVE
    DELETED
}

enum AgentVersionStatus {
    DRAFT
    PUBLISHED
    DELETED
}

model Agent {
    id                 String              @id @default(cuid())
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt
    organizationId     String
    organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    name               String
    description        String?
    status             AgentStatus         @default(ACTIVE)
    draftVersionId     String?
    draftVersion       AgentVersion?       @relation("AgentDraftVersion", fields: [draftVersionId], references: [id], onDelete: SetNull)
    publishedVersionId String?
    publishedVersion   AgentVersion?       @relation("AgentPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
    versions           AgentVersion[]      @relation("AgentVersions")
    trials             AgentTrial[]
    sessions           AgentSession[]
    transcripts        Transcript[]
    sessionUsages      SessionUsage[]
    egressJobs         EgressJob[]
    campaigns          Campaign[]
    knowledgeBases     AgentKnowledgeBase[]
    phoneNumbers       PhoneNumber[]
    dispatchRules      DispatchRule[]
    usageMetrics       UsageMetric[]
    embedEnabled       Boolean             @default(false)
    token              String?             @unique

    @@index([organizationId])
    @@map("agent")
}

model AgentVersion {
    id             String             @id @default(cuid())
    agentId        String
    agent          Agent              @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    organizationId String
    organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    isDraft        Boolean            @default(true)
    version        AgentVersionStatus @default(DRAFT)
    config         Json               @default("{}")
    draftFor       Agent[]            @relation("AgentDraftVersion")
    publishedFor   Agent[]            @relation("AgentPublishedVersion")
    sessions       AgentSession[]

    @@index([agentId])
    @@index([organizationId])
    @@map("agent_version")
}

model AgentTrial {
    id         String    @id @default(cuid())
    agentId    String
    agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    token      String?   @unique
    enabled    Boolean   @default(false)
    usageLimit Int       @default(0)
    usageCount Int       @default(0)
    expiresAt  DateTime?

    @@index([agentId])
    @@map("agent_trial")
}

// ------------------------------------------------------------
// ----------------------------- Runtime sessions (LiveKit) ---
// ------------------------------------------------------------

enum AgentSessionStatus {
    QUEUED
    ACTIVE
    COMPLETED
    FAILED
    CANCELLED
}

enum AgentSessionChannel {
    WEB
    SIP
    PHONE
}

enum AgentSessionDirection {
    NONE
    INBOUND
    OUTBOUND
    WEB
}

enum SessionEndReason {
    COMPLETED
    PARTICIPANT_LEFT
    ROOM_FINISHED
    ERROR
    CANCELLED
    TIMEOUT
}

enum TranscriptStatus {
    PENDING
    PARTIAL
    FINAL
    FAILED
}

enum TranscriptRole {
    USER
    ASSISTANT
    SYSTEM
    TOOL
}

enum ToolCallStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
}

enum SessionEventActor {
    AGENT
    USER
    SYSTEM
    WORKER
}

enum UsageModality {
    LLM
    REALTIME
    STT
    TTS
    VAD
    AVATAR
    SIP
    LIVEKIT_ROOM
    EGRESS
}

enum UnitSource {
    LIVEKIT_INFERENCE
    BYOK
    PLATFORM
}

model AgentSession {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    agentId        String
    agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
    agentVersionId String
    agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)

    livekitRoomName  String
    livekitRoomSid   String?
    livekitJobId     String?
    livekitWorkerId  String?

    channel   AgentSessionChannel   @default(WEB)
    direction AgentSessionDirection @default(NONE)

    sipTrunkId         String?
    sipTrunk           SipTrunk?     @relation(fields: [sipTrunkId], references: [id], onDelete: SetNull)
    sipDispatchRuleId  String?
    sipDispatchRule    DispatchRule? @relation(fields: [sipDispatchRuleId], references: [id], onDelete: SetNull)
    sipCallId          String?
    fromNumber         String?
    toNumber           String?
    sipAttrs           Json          @default("{}")

    status      AgentSessionStatus @default(QUEUED)
    startedAt   DateTime?
    connectedAt DateTime?
    endedAt     DateTime?
    durationMs  Int?

    endReason    SessionEndReason?
    errorCode    String?
    errorMessage String?           @db.Text

    configSnapshot       Json             @default("{}")
    livekitSessionReport Json?
    recordingEnabled     Boolean          @default(false)
    transcriptStatus     TranscriptStatus @default(PENDING)

    campaignSession CampaignSession? @relation("CampaignAgentSession")

    externalUserId String?
    metadata       Json    @default("{}")

    events     SessionEvent[]
    transcript Transcript?
    toolCalls  ToolCallRecord[]
    usages     SessionUsage[]
    egressJobs EgressJob[]

    @@index([organizationId, startedAt])
    @@index([agentId, startedAt])
    @@index([livekitRoomName])
    @@index([livekitRoomSid])
    @@index([livekitJobId])
    @@index([status])
    @@index([sipTrunkId])
    @@index([sipDispatchRuleId])
    @@map("agent_session")
}

model SessionEvent {
    id             String            @id @default(cuid())
    createdAt      DateTime          @default(now())
    organizationId String
    organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    sessionId      String
    session        AgentSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    sequence       Int
    eventType      String
    actor          SessionEventActor @default(AGENT)
    occurredAt     DateTime          @default(now())
    payload        Json              @default("{}")

    @@unique([sessionId, sequence])
    @@index([organizationId, occurredAt])
    @@index([sessionId, occurredAt])
    @@map("session_event")
}

model Transcript {
    id             String           @id @default(cuid())
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    organizationId String
    organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    sessionId      String           @unique
    session        AgentSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    agentId        String
    agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
    language       String?
    status         TranscriptStatus @default(PENDING)
    fullText       String           @default("") @db.Text
    wordCount      Int              @default(0)
    storageUri     String?
    retentionExpiresAt DateTime?

    segments TranscriptSegment[]

    @@index([organizationId])
    @@index([agentId])
    @@map("transcript")
}

model TranscriptSegment {
    id               String         @id @default(cuid())
    createdAt        DateTime       @default(now())
    transcriptId     String
    transcript       Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
    sessionId        String
    sequence         Int
    role             TranscriptRole
    speakerIdentity  String?
    text             String         @default("") @db.Text
    startMs          Int?
    endMs            Int?
    confidence       Float?
    isFinal          Boolean        @default(false)
    interrupted      Boolean        @default(false)
    livekitMessageId String?
    metrics          Json           @default("{}")

    toolCalls ToolCallRecord[]

    @@unique([transcriptId, sequence])
    @@index([sessionId, sequence])
    @@map("transcript_segment")
}

model ToolCallRecord {
    id                   String         @id @default(cuid())
    createdAt            DateTime       @default(now())
    organizationId       String
    organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    sessionId            String
    session              AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    transcriptSegmentId  String?
    transcriptSegment    TranscriptSegment? @relation(fields: [transcriptSegmentId], references: [id], onDelete: SetNull)
    toolName             String
    arguments            Json           @default("{}")
    result               Json           @default("{}")
    status               ToolCallStatus @default(COMPLETED)
    error                String?        @db.Text
    startedAt            DateTime?
    completedAt          DateTime?

    @@index([sessionId])
    @@index([organizationId])
    @@index([transcriptSegmentId])
    @@map("tool_call_record")
}

// ------------------------------------------------------------
// ----------------------------- Campaigns --------------------
// ------------------------------------------------------------
// Three primary modes:
// 1) OUTBOUND_LIST — org uploads contacts + personal context; agent dials/messages them
// 2) INBOUND_OPEN  — open channel (e.g. support line); anyone can start a session
// 3) WEB_LINK      — shareable/embed link; optional per-person personalized context

enum CampaignStatus {
    DRAFT
    ACTIVE
    PAUSED
    COMPLETED
    ARCHIVED
}

enum CampaignMode {
    OUTBOUND_LIST
    INBOUND_OPEN
    WEB_LINK
}

enum CampaignChannel {
    VOICE
    WEB
}

enum CampaignPriority {
    LOW
    NORMAL
    HIGH
}

enum CampaignContactStatus {
    PENDING
    QUEUED
    IN_PROGRESS
    COMPLETED
    FAILED
    SKIPPED
    DO_NOT_CONTACT
    PAUSED
    RESCHEDULED
    CANCELLED
}

enum CampaignSessionStatus {
    QUEUED
    STARTED
    IN_PROGRESS
    COMPLETED
    FAILED
    ABANDONED
    PAUSED
    RESCHEDULED
}

enum CampaignSessionDirection {
    INBOUND
    OUTBOUND
    WEB
}

enum CampaignAccessLinkKind {
    /// Single open link for the campaign (inbound / public embed)
    OPEN
    /// Unique link tied to one contact + prefilled personal context
    PERSONALIZED
}

model Campaign {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    agentId        String
    agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)

    name        String
    description String?
    status      CampaignStatus   @default(DRAFT)
    mode        CampaignMode
    channel     CampaignChannel
    priority    CampaignPriority @default(NORMAL)

    /// Declares expected personal-context keys for contacts / embeds
    /// e.g. [{ "key": "company", "label": "Company", "required": true }]
    contextSchema Json @default("[]")

    // --- scheduling / dialer (primarily OUTBOUND_LIST) ---
    startAt                DateTime?
    endAt                  DateTime?
    timezone               String?   @default("UTC")
    callingWindowStartHour Int? // 0-23 local
    callingWindowEndHour   Int? // 0-23 local
    maxConcurrentSessions  Int       @default(1)
    maxAttemptsPerContact  Int       @default(3)
    retryDelayMinutes      Int       @default(60)

    // --- open access (INBOUND_OPEN / WEB_LINK public entry) ---
    publicToken String? @unique
    embedEnabled Boolean @default(false)
    /// Optional phone / SIP identity for inbound voice
    inboundAddress String?

    metadata Json @default("{}")

    contacts       CampaignContact[]
    accessLinks    CampaignAccessLink[]
    sessions       CampaignSession[]
    knowledgeBases CampaignKnowledgeBase[]
    phoneNumbers   PhoneNumber[]
    dispatchRules  DispatchRule[]
    usageMetrics   UsageMetric[]

    @@index([organizationId, status])
    @@index([agentId])
    @@index([mode, status])
    @@map("campaign")
}

model CampaignContact {
    id             String                @id @default(cuid())
    createdAt      DateTime              @default(now())
    updatedAt      DateTime              @updatedAt
    organizationId String
    organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    campaignId     String
    campaign       Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)

    displayName String?
    phoneE164   String?
    email       String?
    timezone    String?
    locale      String?
    externalId  String? // CRM / upload row id

    /// Freeform personal context injected into the agent (name, company, notes, etc.)
    context Json @default("{}")

    status           CampaignContactStatus @default(PENDING)
    attemptCount     Int                   @default(0)
    lastAttemptAt    DateTime?
    nextAttemptAt    DateTime?
    lastOutcome      String?
    doNotContact     Boolean               @default(false)
    consentGiven     Boolean               @default(false)
    consentAt        DateTime?
    consentSource    String?

    /// Rolling conversation memory for natural recalls
    memorySummary   String?   @db.Text
    memoryUpdatedAt DateTime?

    metadata Json @default("{}")

    accessLinks CampaignAccessLink[]
    sessions    CampaignSession[]

    @@index([campaignId, status])
    @@index([campaignId, nextAttemptAt])
    @@index([organizationId])
    @@index([phoneE164])
    @@index([email])
    @@unique([campaignId, externalId])
    @@map("campaign_contact")
}

model CampaignAccessLink {
    id             String                 @id @default(cuid())
    createdAt      DateTime               @default(now())
    updatedAt      DateTime               @updatedAt
    organizationId String
    organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    campaignId     String
    campaign       Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
    contactId      String?
    contact        CampaignContact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)

    kind    CampaignAccessLinkKind
    token   String                 @unique
    enabled Boolean                @default(true)
    label   String?

    /// Extra context baked into this link (merged with contact.context at runtime)
    contextOverrides Json @default("{}")

    expiresAt DateTime?
    maxUses   Int?
    useCount  Int       @default(0)

    metadata Json @default("{}")

    sessions CampaignSession[]

    @@index([campaignId, kind])
    @@index([contactId])
    @@index([organizationId])
    @@map("campaign_access_link")
}

model CampaignSession {
    id             String              @id @default(cuid())
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt
    organizationId String
    organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    campaignId     String
    campaign       Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
    contactId      String?
    contact        CampaignContact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
    accessLinkId   String?
    accessLink     CampaignAccessLink? @relation(fields: [accessLinkId], references: [id], onDelete: SetNull)

    channel   CampaignChannel
    direction CampaignSessionDirection @default(WEB)
    status    CampaignSessionStatus    @default(STARTED)
    startedAt DateTime                 @default(now())
    endedAt   DateTime?

    /// Snapshot of personal context used for this session
    contextSnapshot Json    @default("{}")
    outcome         String?
    summary         String? @db.Text
    transcript      Json?
    messages        Json?
    recordingUrl    String?
    durationSeconds Int?

    livekitRoomName String?
    livekitRoomSid  String?
    parentSessionId String?
    parentSession   CampaignSession?  @relation("SessionContinuation", fields: [parentSessionId], references: [id], onDelete: SetNull)
    childSessions   CampaignSession[] @relation("SessionContinuation")

    egressId     String?
    egressStatus String?

    agentSessionId String?       @unique
    agentSession   AgentSession? @relation("CampaignAgentSession", fields: [agentSessionId], references: [id], onDelete: SetNull)

    metadata Json @default("{}")

    egressJobs   EgressJob[]
    usageMetrics UsageMetric[]

    @@index([campaignId, status])
    @@index([contactId, startedAt])
    @@index([accessLinkId])
    @@index([organizationId, startedAt])
    @@index([livekitRoomName])
    @@index([parentSessionId])
    @@map("campaign_session")
}

// ------------------------------------------------------------
// ----------------------------- Knowledge Base ---------------
// ------------------------------------------------------------

enum KnowledgeBaseStatus {
    ACTIVE
    ARCHIVED
    DELETED
}

enum DocumentStatus {
    PENDING
    PROCESSING
    READY
    FAILED
    DELETED
}

enum DocumentSourceType {
    UPLOAD
    URL
    TEXT
    API
}

model KnowledgeBase {
    id              String              @id @default(cuid())
    createdAt       DateTime            @default(now())
    updatedAt       DateTime            @updatedAt
    organizationId  String
    organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    name            String
    description     String?
    embeddingModel  String              @default("text-embedding-3-small")
    embeddingDim    Int                 @default(1536)
    status          KnowledgeBaseStatus @default(ACTIVE)
    metadata        Json                @default("{}")

    documents  Document[]
    agents     AgentKnowledgeBase[]
    campaigns  CampaignKnowledgeBase[]

    @@index([organizationId, status])
    @@map("knowledge_base")
}

model Document {
    id             String             @id @default(cuid())
    createdAt      DateTime           @default(now())
    updatedAt      DateTime           @updatedAt
    knowledgeBaseId String
    knowledgeBase  KnowledgeBase      @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
    title          String
    sourceType     DocumentSourceType @default(UPLOAD)
    sourceUrl      String?
    storageKey     String?
    status         DocumentStatus     @default(PENDING)
    errorMessage   String?
    metadata       Json               @default("{}")

    chunks DocumentChunk[]

    @@index([knowledgeBaseId, status])
    @@map("document")
}

model DocumentChunk {
    id         String                      @id @default(cuid())
    createdAt  DateTime                    @default(now())
    updatedAt  DateTime                    @updatedAt
    documentId String
    document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
    content    String                      @db.Text
    chunkIndex Int
    tokenCount Int?
    metadata   Json                        @default("{}")
    /// Embedding vector stored as JSON number array (portable; swap to pgvector later if needed)
    embedding  Json?

    @@unique([documentId, chunkIndex])
    @@index([documentId])
    @@map("document_chunk")
}

model AgentKnowledgeBase {
    id              String        @id @default(cuid())
    createdAt       DateTime      @default(now())
    agentId         String
    agent           Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
    knowledgeBaseId String
    knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

    @@unique([agentId, knowledgeBaseId])
    @@index([knowledgeBaseId])
    @@map("agent_knowledge_base")
}

model CampaignKnowledgeBase {
    id              String        @id @default(cuid())
    createdAt       DateTime      @default(now())
    campaignId      String
    campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
    knowledgeBaseId String
    knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

    @@unique([campaignId, knowledgeBaseId])
    @@index([knowledgeBaseId])
    @@map("campaign_knowledge_base")
}

// ------------------------------------------------------------
// ----------------------------- Telephony --------------------
// ------------------------------------------------------------

enum SipTrunkDirection {
    INBOUND
    OUTBOUND
}

enum EgressJobStatus {
    STARTING
    ACTIVE
    ENDING
    COMPLETE
    FAILED
    ABORTED
}

enum EgressJobType {
    ROOM_COMPOSITE
    PARTICIPANT
    TRACK
    WEB
}

model PhoneNumber {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    campaignId     String?
    campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
    agentId        String?
    agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
    sipTrunkId     String?
    sipTrunk       SipTrunk?    @relation(fields: [sipTrunkId], references: [id], onDelete: SetNull)

    e164           String
    plivoNumberId  String?
    friendlyName   String?
    capabilities   Json         @default("{}")
    metadata       Json         @default("{}")

    @@unique([organizationId, e164])
    @@index([campaignId])
    @@index([agentId])
    @@index([sipTrunkId])
    @@map("phone_number")
}

model SipTrunk {
    id             String            @id @default(cuid())
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt
    organizationId String
    organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    name              String
    direction         SipTrunkDirection
    livekitTrunkId    String?
    plivoTrunkId      String?
    plivoUriId        String?
    plivoCredentialId String?
    authUsername      String?
    hasCredentials    Boolean          @default(false)
    numbers           String[]         @default([])
    metadata          Json             @default("{}")

    phoneNumbers  PhoneNumber[]
    dispatchRules DispatchRule[]
    agentSessions AgentSession[]

    @@index([organizationId, direction])
    @@index([livekitTrunkId])
    @@map("sip_trunk")
}

model DispatchRule {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    sipTrunkId     String?
    sipTrunk       SipTrunk?    @relation(fields: [sipTrunkId], references: [id], onDelete: SetNull)
    agentId        String?
    agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
    campaignId     String?
    campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

    name                  String
    livekitDispatchRuleId String?
    roomPrefix            String?
    ruleConfig            Json    @default("{}")
    metadata              Json    @default("{}")

    agentSessions AgentSession[]

    @@index([organizationId])
    @@index([sipTrunkId])
    @@index([agentId])
    @@index([campaignId])
    @@map("dispatch_rule")
}

model CustomVoice {
    id                String       @id @default(cuid())
    createdAt         DateTime     @default(now())
    updatedAt         DateTime     @updatedAt
    organizationId    String
    organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    name              String
    livekitVoiceId    String?
    sampleStorageKeys String[]     @default([])
    metadata          Json         @default("{}")

    @@index([organizationId])
    @@index([livekitVoiceId])
    @@map("custom_voice")
}

model EgressJob {
    id                String             @id @default(cuid())
    createdAt         DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
    organizationId    String
    organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    campaignSessionId String?
    campaignSession   CampaignSession?   @relation(fields: [campaignSessionId], references: [id], onDelete: SetNull)
    agentSessionId    String?
    agentSession      AgentSession?      @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
    agentId           String?
    agent             Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)

    livekitEgressId String?
    type            EgressJobType
    status          EgressJobStatus      @default(STARTING)
    roomName        String?
    outputUrls      String[]             @default([])
    destination     Json                 @default("{}")
    fileUrl         String?
    durationMs      Int?
    sizeBytes       Int?
    errorMessage    String?
    metadata        Json                 @default("{}")

    @@index([organizationId, status])
    @@index([campaignSessionId])
    @@index([agentSessionId])
    @@index([agentId])
    @@index([livekitEgressId])
    @@map("egress_job")
}

// ------------------------------------------------------------
// ----------------------------- Avatars (Anam) ---------------
// ------------------------------------------------------------

model AvatarProfile {
    id             String       @id @default(cuid())
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

    name          String
    anamAvatarId  String
    anamPersonaId String?
    previewUrl    String?
    metadata      Json          @default("{}")

    @@index([organizationId])
    @@index([anamAvatarId])
    @@map("avatar_profile")
}

// ------------------------------------------------------------
// ----------------------------- Usage Metrics ----------------
// ------------------------------------------------------------

enum UsageMetricSource {
    AGENT
    CAMPAIGN
    SESSION
}

enum UsageMetricCategory {
    LLM
    STT
    TTS
    AVATAR
    SIP
    EGRESS
    ROOM
}

model UsageMetric {
    id                String              @id @default(cuid())
    createdAt         DateTime            @default(now())
    organizationId    String
    organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    agentId           String?
    agent             Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
    campaignId        String?
    campaign          Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
    campaignSessionId String?
    campaignSession   CampaignSession?    @relation(fields: [campaignSessionId], references: [id], onDelete: SetNull)

    source     UsageMetricSource
    category   UsageMetricCategory
    provider   String?
    metric     String
    value      Decimal            @db.Decimal(20, 6)
    unit       String
    recordedAt DateTime           @default(now())
    metadata   Json               @default("{}")

    @@index([organizationId, recordedAt])
    @@index([agentId, recordedAt])
    @@index([campaignId, recordedAt])
    @@index([campaignSessionId])
    @@map("usage_metric")
}

model SessionUsage {
    id             String         @id @default(cuid())
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt
    organizationId String
    organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    sessionId      String
    session        AgentSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    agentId        String
    agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
    modality       UsageModality
    provider       String
    model          String
    unitSource     UnitSource     @default(LIVEKIT_INFERENCE)

    inputTokens             Int @default(0)
    inputCachedTokens       Int @default(0)
    inputCachedAudioTokens  Int @default(0)
    inputCachedTextTokens   Int @default(0)
    inputCachedImageTokens  Int @default(0)
    inputAudioTokens        Int @default(0)
    inputTextTokens         Int @default(0)
    inputImageTokens        Int @default(0)
    outputTokens            Int @default(0)
    outputAudioTokens       Int @default(0)
    outputTextTokens        Int @default(0)
    providerSessionDurationMs Int @default(0)

    charactersCount Int @default(0)
    audioDurationMs Int @default(0)
    totalRequests   Int @default(0)

    videoDurationMs    Int @default(0)
    callDurationMs     Int @default(0)
    billableMinutes    Int @default(0)
    participantMinutes Int @default(0)
    egressMinutes      Int @default(0)
    egressBytes        Int @default(0)

    raw       Json     @default("{}")
    capturedAt DateTime @default(now())
    isFinal   Boolean  @default(false)

    @@unique([sessionId, modality, provider, model])
    @@index([organizationId, capturedAt])
    @@index([agentId])
    @@index([sessionId])
    @@map("session_usage")
}
