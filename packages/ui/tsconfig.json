{
	"extends": "@repo/tsconfig/base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
		"paths": {
			"~/components/*": ["./src/shadcn/*"],
			"~/utils": ["./src/utils"],
			"~/utils/*": ["./src/utils/*"],
			"~/hooks/*": ["./src/hooks/*"],
			"~/ui/*": ["./src/shadcn/*"]
		}
	},
	"include": ["*.ts", "src"],
	"exclude": ["node_modules"]
}
